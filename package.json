{
  "name": "lampa-desktop",
  "productName": "Lampa",
  "version": "1.5.1",
  "description": "Десктопное приложение-клиент для Lampa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kolovatoff/lampa-desktop"
  },
  "desktopName": "lampa-desktop",
  "main": "src/main.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": "please-use-yarn",
    "yarn": ">= 4.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build-linux": "electron-builder --linux --publish=never",
    "build-mac": "electron-builder --mac --publish=never",
    "build-win": "electron-builder --win --publish=never",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lintfix": "eslint . --fix && prettier --write --list-different .",
    "release:changelog": "commit-and-tag-version",
    "release": "yarn release:changelog && git push --follow-tags origin $CI_COMMIT_REF_NAME",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "commit-and-tag-version": {
    "scripts": {
      "postchangelog": "yarn lintfix"
    }
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "which": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "commit-and-tag-version": "12.7.3",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6"
  },
  "author": {
    "name": "Kolovatoff",
    "email": "kirill@kolovatov.ru"
  },
  "license": "MIT",
  "build": {
    "appId": "com.lampa.desktop",
    "productName": "Lampa",
    "artifactName": "lampa-${arch}-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        "AppImage"
      ],
      "icon": "build/icons/linux",
      "category": "Multimedia",
      "desktop": {
        "entry": {
          "Name": "Lampa",
          "Comment": "Десктопное приложение-клиент для Lampa",
          "Categories": "Multimedia;",
          "StartupWMClass": "lampa-desktop",
          "MimeType": "application/x-lampa"
        }
      },
      "maintainer": "Kirill Kolovatov <kirill@kolovatov.ru>",
      "vendor": "Kolovatoff",
      "executableName": "lampa-desktop"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/mac/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/win/icon.ico",
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "installerIcon": "build/icons/win/icon.ico",
      "uninstallerIcon": "build/icons/win/icon.ico",
      "license": "LICENSE"
    },
    "publish": {
      "provider": "github",
      "owner": "Kolovatoff",
      "repo": "lampa-desktop"
    }
  },
  "files": [
    "src/**/*",
    "node_modules/*",
    "build/icon.svg",
    "build/icon.png",
    "build/icons/**/*"
  ],
  "packageManager": "yarn@4.9.4"
}
