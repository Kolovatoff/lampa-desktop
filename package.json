{
  "name": "lampa-desktop",
  "productName": "Lampa",
  "version": "1.7.0",
  "description": "Десктопное приложение-клиент для Lampa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kolovatoff/lampa-desktop"
  },
  "desktopName": "lampa",
  "main": "src/main.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": "please-use-yarn",
    "yarn": ">= 4.0.0"
  },
  "scripts": {
    "start": "node scripts/with-electron-env.js electron .",
    "dev": "node scripts/with-electron-env.js electron . --dev",
    "build-linux": "electron-builder --linux --config electron-builder.linux.js --publish=never",
    "build-mac": "electron-builder --mac --config electron-builder.mac.js --publish=never",
    "build-win": "electron-builder --win --config electron-builder.win.js --publish=never",
    "test": "node --test tests/*.test.js",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lintfix": "eslint . --fix && prettier --write --list-different .",
    "release:changelog": "commit-and-tag-version",
    "release": "yarn release:changelog && git push --follow-tags origin $CI_COMMIT_REF_NAME",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "commit-and-tag-version": {
    "scripts": {
      "postchangelog": "yarn lintfix"
    }
  },
  "dependencies": {
    "electron-store": "12.0.0",
    "electron-updater": "6.8.11",
    "which": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "commit-and-tag-version": "13.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "author": {
    "name": "Kolovatoff",
    "email": "kirill@kolovatov.ru"
  },
  "license": "MIT",
  "build": {
    "appId": "com.lampa.desktop",
    "productName": "Lampa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "Kolovatoff",
      "repo": "lampa-desktop"
    },
    "electronDownload": {
      "mirror": "https://lampa.kolovatoff.ru/electron/"
    }
  },
  "files": [
    "src/**/*",
    "node_modules/*",
    "build/icon.svg",
    "build/icon.png",
    "build/icons/**/*"
  ],
  "packageManager": "yarn@4.9.4"
}
